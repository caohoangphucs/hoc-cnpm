# PostgreSQL 16. Compose reads .env; Java on the host needs exported DB_* variables.
PORT_WEB=8091
PORT_DB=54321
PORT_API=8080
DB_NAME=cnpm_db
DB_USER=cnpm_user
DB_PASS=cnpm_pass_2026
TOTP_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters
# Host Java connection (Compose sets cnpm-db:5432 for the app):
DB_HOST=localhost
DB_PORT=54321
