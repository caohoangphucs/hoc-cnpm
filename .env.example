# PostgreSQL 16. Compose reads .env; Java on the host needs exported DB_* variables.
PORT_WEB=8091
PORT_DB=54321
PORT_API=8080
DB_NAME=cnpm_db
DB_USER=cnpm_user
DB_PASS=cnpm_pass_2026
TOTP_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters
# Host Java connection (Compose sets cnpm-db:5432 for the app):
DB_HOST=localhost
DB_PORT=54321

# VNPAY Sandbox: đặt khóa thực trong .env/runtime.env, không commit.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:8091/api/v1/payments/vnpay/return
