        <class>vn.id.caohoangphuc.cnpm.entity.Phong</class>
        <class>vn.id.caohoangphuc.cnpm.entity.Giuong</class>
        <class>vn.id.caohoangphuc.cnpm.entity.SinhVien</class>
        <class>vn.id.caohoangphuc.cnpm.entity.DangKyPhong</class>
        <class>vn.id.caohoangphuc.cnpm.entity.LuuTru</class>
        <class>vn.id.caohoangphuc.cnpm.entity.DonGiaDichVu</class>
        <class>vn.id.caohoangphuc.cnpm.entity.ChiSoDienNuoc</class>
        <class>vn.id.caohoangphuc.cnpm.entity.HoaDon</class>
        <class>vn.id.caohoangphuc.cnpm.entity.ChiTietHoaDon</class>
        <class>vn.id.caohoangphuc.cnpm.entity.ThanhToan</class>
        <class>vn.id.caohoangphuc.cnpm.entity.RaVao</class>
        <class>vn.id.caohoangphuc.cnpm.entity.ViPham</class>
        <class>vn.id.caohoangphuc.cnpm.entity.VatTu</class>
        <class>vn.id.caohoangphuc.cnpm.entity.YeuCauSuaChua</class>
        <class>vn.id.caohoangphuc.cnpm.entity.XuatVatTu</class>
        <class>vn.id.caohoangphuc.cnpm.entity.AuditLog</class>
        <class>vn.id.caohoangphuc.cnpm.entity.HocKy</class>
        <class>vn.id.caohoangphuc.cnpm.entity.DotDangKy</class>
        <class>vn.id.caohoangphuc.cnpm.entity.ChinhSachGiamGia</class>
        <class>vn.id.caohoangphuc.cnpm.entity.SinhVienChinhSach</class>
        <class>vn.id.caohoangphuc.cnpm.entity.HoatDong</class>
        <class>vn.id.caohoangphuc.cnpm.entity.DangKyCongIch</class>
