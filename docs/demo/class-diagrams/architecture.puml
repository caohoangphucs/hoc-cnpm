@startuml
!pragma layout smetana
skinparam classAttributeIconSize 0
left to right direction
title Spring Boot 4.1.1 / PostgreSQL16 — thiết kế đích 8 UC
package "Web / Security" {
 class ThymeleafViews
 class SecurityFilterChain <<Spring Security>>
 class GlobalExceptionHandler <<@RestControllerAdvice>>
 class BookingController <<@RestController>>
 class RegistrationController <<@RestController>>
 class InvoiceController <<@RestController>>
 class PaymentController <<@RestController>>
 class RepairController <<@RestController>>
 class GateController <<@RestController>>
 class DisciplineController <<@RestController>>
 class CommunityController <<@RestController>>
 class PaymentCallbackController <<@RestController>>
}
package "Services" {
 class BookingService <<@Service / @Transactional>> {
 +book()
}
 class RegistrationService <<@Service / @Transactional>> {
 +decide()
}
 class InvoiceService <<@Service / @Transactional>> {
 +preview()
 +issue()
}
 class PaymentService <<@Service / @Transactional>> {
 +createSession()
 +handleIpn()
}
 class RepairService <<@Service / @Transactional>> {
 +assign()
 +complete()
}
 class GateService <<@Service / @Transactional>> {
 +record()
 +approveVisitor()
}
 class DisciplineService <<@Service / @Transactional>> {
 +decide()
 +respondAppeal()
}
 class CommunityService <<@Service / @Transactional>> {
 +register()
 +cancel()
 +confirm()
 +convert()
 +certificate()
}
}
package "Persistence" {
 class RoomRepository <<@Repository>>
 class InvoiceRepository <<@Repository>>
 class PaymentRepository <<@Repository>>
 class RepairRepository <<@Repository>>
 class GateRepository <<@Repository>>
 class DisciplineRepository <<@Repository>>
 class CommunityRepository <<@Repository>>
 class JdbcTemplate <<Spring JDBC>>
 class JdbcTransactionManager <<Spring>>
 class HikariDataSource <<auto-configured>>
}
package "Integration / Jobs" {
 interface PaymentGateway {
  +create()
  +verifyCallback()
  +query()
 }
 class VnpayAdapter
 class MomoAdapter
 class OutboxWorker <<@Scheduled>>
 interface NotificationAdapter
 interface CTSVAdapter
 interface BarrierAdapter
 interface CertificateSigner
}
class PostgreSQL16 <<database>> {
 +procedures : PL/pgSQL
 +constraints : FK, UNIQUE, CHECK
}
ThymeleafViews --> SecurityFilterChain
SecurityFilterChain --> BookingController
BookingController --> BookingService
BookingService --> RoomRepository
BookingService ..> JdbcTransactionManager
SecurityFilterChain --> RegistrationController
RegistrationController --> RegistrationService
RegistrationService --> RoomRepository
RegistrationService ..> JdbcTransactionManager
SecurityFilterChain --> InvoiceController
InvoiceController --> InvoiceService
InvoiceService --> InvoiceRepository
InvoiceService ..> JdbcTransactionManager
SecurityFilterChain --> PaymentController
PaymentController --> PaymentService
PaymentService --> PaymentRepository
PaymentService ..> JdbcTransactionManager
SecurityFilterChain --> RepairController
RepairController --> RepairService
RepairService --> RepairRepository
RepairService ..> JdbcTransactionManager
SecurityFilterChain --> GateController
GateController --> GateService
GateService --> GateRepository
GateService ..> JdbcTransactionManager
SecurityFilterChain --> DisciplineController
DisciplineController --> DisciplineService
DisciplineService --> DisciplineRepository
DisciplineService ..> JdbcTransactionManager
SecurityFilterChain --> CommunityController
CommunityController --> CommunityService
CommunityService --> CommunityRepository
CommunityService ..> JdbcTransactionManager
RoomRepository --> JdbcTemplate
InvoiceRepository --> JdbcTemplate
PaymentRepository --> JdbcTemplate
RepairRepository --> JdbcTemplate
GateRepository --> JdbcTemplate
DisciplineRepository --> JdbcTemplate
CommunityRepository --> JdbcTemplate
SecurityFilterChain --> PaymentCallbackController : chỉ miễn CSRF đúng IPN
PaymentCallbackController --> PaymentService : chữ ký provider bắt buộc
PaymentService --> PaymentGateway
VnpayAdapter ..|> PaymentGateway
MomoAdapter ..|> PaymentGateway
JdbcTemplate --> HikariDataSource
JdbcTransactionManager --> HikariDataSource
HikariDataSource --> PostgreSQL16
OutboxWorker --> JdbcTemplate
OutboxWorker --> NotificationAdapter
OutboxWorker --> CTSVAdapter
OutboxWorker --> BarrierAdapter
OutboxWorker --> CertificateSigner
GlobalExceptionHandler ..> BookingController : Error DTO chung
note bottom of JdbcTransactionManager
 @Transactional tại Service; cùng DataSource/Connection.
 JdbcTemplate gọi procedure; khóa/cập nhật liên bảng nằm trong SP.
 Không gọi mạng khi giữ transaction.
end note
@enduml
