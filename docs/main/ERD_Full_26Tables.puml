@startuml
!theme plain
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 5
skinparam classFontSize 11
skinparam classAttributeFontSize 10

title ERD Toàn Bộ Cơ Sở Dữ Liệu PostgreSQL (26 Bảng) — Hệ Thống Quản Lý KTX

package "1. Phân Hệ Người Dùng & Phân Quyền" {
  entity "TAI_KHOAN" as TAI_KHOAN {
    * **MaTaiKhoan** : SERIAL <<PK>>
    --
    * TenDangNhap : VARCHAR(50) <<UQ>>
    * MatKhauHash : VARCHAR(255)
    * HoTen : VARCHAR(100)
    * Email : VARCHAR(100) <<UQ>>
    SoDienThoai : VARCHAR(20)
    * VaiTro : VARCHAR(20)
    * TrangThai : VARCHAR(20)
    NgayTao : TIMESTAMP
  }

  entity "SINH_VIEN" as SINH_VIEN {
    * **MaSinhVien** : VARCHAR(20) <<PK>>
    --
    MaTaiKhoan : INT <<FK, UQ>>
    * HoTen : VARCHAR(100)
    NgaySinh : DATE
    * GioiTinh : VARCHAR(10)
    * CCCD : VARCHAR(20) <<UQ>>
    * Email : VARCHAR(100) <<UQ>>
    * SoDienThoai : VARCHAR(20)
    Lop : VARCHAR(50)
    Khoa : VARCHAR(100)
    QueQuan : VARCHAR(255)
    MaPhongHienTai : VARCHAR(20) <<FK>>
    * TrangThai : VARCHAR(20)
  }
}

package "2. Phân Hệ Tòa Nhà, Phòng & Học Kỳ" {
  entity "HOC_KY" as HOC_KY {
    * **MaHocKy** : VARCHAR(20) <<PK>>
    --
    * TenHocKy : VARCHAR(100)
    * NgayBatDau : DATE
    * NgayKetThuc : DATE
    * TrangThai : VARCHAR(20)
  }

  entity "DOT_DANG_KY" as DOT_DANG_KY {
    * **MaDot** : SERIAL <<PK>>
    --
    * MaHocKy : VARCHAR(20) <<FK>>
    * TenDot : VARCHAR(100)
    * ThoiGianMo : TIMESTAMP
    * ThoiGianDong : TIMESTAMP
    * TrangThai : VARCHAR(20)
  }

  entity "TOA_NHA" as TOA_NHA {
    * **MaToaNha** : VARCHAR(20) <<PK>>
    --
    * TenToa : VARCHAR(100)
    * SoTang : INT
    GioiTinhApDung : VARCHAR(20)
    GhiChu : VARCHAR(255)
  }

  entity "LOAI_PHONG" as LOAI_PHONG {
    * **MaLoaiPhong** : VARCHAR(20) <<PK>>
    --
    * TenLoaiPhong : VARCHAR(100)
    * SucChuaTieuChuan : INT
    * DonGiaThang : DECIMAL(15,0)
    MoTa : TEXT
  }

  entity "PHONG" as PHONG {
    * **MaPhong** : VARCHAR(20) <<PK>>
    --
    * MaToaNha : VARCHAR(20) <<FK>>
    MaLoaiPhong : VARCHAR(20) <<FK>>
    * SoPhong : VARCHAR(20)
    * Tang : INT
    * SucChua : INT
    * DangO : INT
    * GiaPhongCoBan : DECIMAL(15,0)
    * TrangThai : VARCHAR(20)
  }

  entity "GIUONG" as GIUONG {
    * **MaGiuong** : VARCHAR(20) <<PK>>
    --
    * MaPhong : VARCHAR(20) <<FK>>
    * SoGiuong : VARCHAR(20)
    ViTri : VARCHAR(50)
    * TrangThai : VARCHAR(20)
  }
}

package "3. Phân Hệ Đăng Ký & Lưu Trú" {
  entity "DANG_KY_PHONG" as DANG_KY_PHONG {
    * **MaDangKy** : SERIAL <<PK>>
    --
    * MaSinhVien : VARCHAR(20) <<FK>>
    * MaGiuong : VARCHAR(20) <<FK>>
    * NgayDangKy : TIMESTAMP
    NgayHetHan : TIMESTAMP
    * TrangThai : VARCHAR(20)
    GhiChuLyDo : TEXT
  }

  entity "LUU_TRU" as LUU_TRU {
    * **MaLuuTru** : SERIAL <<PK>>
    --
    * MaDangKy : INT <<FK>>
    * MaSinhVien : VARCHAR(20) <<FK>>
    * MaGiuong : VARCHAR(20) <<FK>>
    * NgayBatDau : DATE
    NgayKetThuc : DATE
    * TrangThai : VARCHAR(20)
  }
}

package "4. Phân Hệ Tài Chính, Hóa Đơn & Chính Sách" {
  entity "CHINH_SACH_GIAM_GIA" as CHINH_SACH_GIAM_GIA {
    * **MaChinhSach** : VARCHAR(20) <<PK>>
    --
    * TenChinhSach : VARCHAR(150)
    * TyLeGiam : DECIMAL(5,2)
    DieuKienApDung : TEXT
    * NgayBatDau : DATE
    NgayKetThuc : DATE
    * TrangThai : VARCHAR(20)
  }

  entity "SINH_VIEN_CHINH_SACH" as SINH_VIEN_CHINH_SACH {
    * **MaSinhVien** : VARCHAR(20) <<PK, FK>>
    * **MaChinhSach** : VARCHAR(20) <<PK, FK>>
    --
    NgayXacNhan : DATE
    NguoiXacNhan : VARCHAR(50)
  }

  entity "DON_GIA_DICH_VU" as DON_GIA_DICH_VU {
    * **MaDichVu** : SERIAL <<PK>>
    --
    * LoaiDichVu : VARCHAR(20) <<UQ>>
    * TenDichVu : VARCHAR(100)
    * DonViTinh : VARCHAR(20)
    * DonGia : DECIMAL(15,0)
    * TrangThai : VARCHAR(20)
  }

  entity "CHI_SO_DIEN_NUOC" as CHI_SO_DIEN_NUOC {
    * **MaChiSo** : SERIAL <<PK>>
    --
    * MaPhong : VARCHAR(20) <<FK>>
    * KyThang : VARCHAR(7)
    * DienCu : INT
    * DienMoi : INT
    * NuocCu : INT
    * NuocMoi : INT
    * NgayGhi : TIMESTAMP
    * NguoiGhi : VARCHAR(50)
  }

  entity "HOA_DON" as HOA_DON {
    * **MaHoaDon** : SERIAL <<PK>>
    --
    * MaPhong : VARCHAR(20) <<FK>>
    * KyThang : VARCHAR(7)
    * TienPhong : DECIMAL(15,0)
    * TienDien : DECIMAL(15,0)
    * TienNuoc : DECIMAL(15,0)
    * TongTien : DECIMAL(15,0)
    * DaThanhToan : DECIMAL(15,0)
    * HanThanhToan : DATE
    * TrangThai : VARCHAR(20)
    NgayTao : TIMESTAMP
  }

  entity "CHI_TIET_HOA_DON" as CHI_TIET_HOA_DON {
    * **MaChiTiet** : SERIAL <<PK>>
    --
    * MaHoaDon : INT <<FK>>
    * TenMuc : VARCHAR(100)
    * SoLuong : DECIMAL(10,2)
    * DonGia : DECIMAL(15,0)
    * ThanhTien : DECIMAL(15,0)
  }

  entity "THANH_TOAN" as THANH_TOAN {
    * **MaThanhToan** : SERIAL <<PK>>
    --
    * MaHoaDon : INT <<FK>>
    * PhuongThuc : VARCHAR(20)
    * SoTien : DECIMAL(15,0)
    * MaGiaoDich : VARCHAR(100) <<UQ>>
    * TrangThai : VARCHAR(20)
    * ThoiGian : TIMESTAMP
    NguoiXacNhan : VARCHAR(50)
    GhiChu : TEXT
  }
}

package "5. Phân Hệ Hoạt Động & Điểm Công Ích (UC-30)" {
  entity "HOAT_DONG" as HOAT_DONG {
    * **MaHoatDong** : VARCHAR(20) <<PK>>
    --
    MaHocKy : VARCHAR(20) <<FK>>
    * TieuDe : VARCHAR(255)
    MoTa : TEXT
    * ThoiGianBatDau : TIMESTAMP
    * ThoiGianKetThuc : TIMESTAMP
    DiaDiem : VARCHAR(255)
    * ChiTieu : INT
    * DaDangKy : INT
    * DiemCongIch : INT
    * TrangThai : VARCHAR(20)
  }

  entity "DANG_KY_CONG_ICH" as DANG_KY_CONG_ICH {
    * **MaDangKyCongIch** : SERIAL <<PK>>
    --
    * MaHoatDong : VARCHAR(20) <<FK>>
    * MaSinhVien : VARCHAR(20) <<FK>>
    * NgayDangKy : TIMESTAMP
    MaQRToken : VARCHAR(100) <<UQ>>
    * TrangThai : VARCHAR(20)
    NguoiXacNhan : VARCHAR(50)
    NgayXacNhan : TIMESTAMP
  }

  entity "SO_DIEM_CONG_ICH" as SO_DIEM_CONG_ICH {
    * **MaGiaoDich** : SERIAL <<PK>>
    --
    * MaSinhVien : VARCHAR(20) <<FK>>
    MaHocKy : VARCHAR(20) <<FK>>
    MaDangKyCongIch : INT <<FK>>
    * SoDiemThayDoi : INT
    * LoaiGiaoDich : VARCHAR(20)
    GhiChu : TEXT
    * ThoiGian : TIMESTAMP
  }

  entity "QUY_DOI_DIEM" as QUY_DOI_DIEM {
    * **MaQuyDoi** : SERIAL <<PK>>
    --
    * MaSinhVien : VARCHAR(20) <<FK>>
    * MaHocKy : VARCHAR(20) <<FK>>
    * DiemCongIchTieu : INT
    * DiemRenLuyenNhan : INT
    * NgayQuyDoi : TIMESTAMP
    * TrangThai : VARCHAR(20)
  }
}

package "6. Phân Hệ Kỹ Thuật, Sửa Chữa & Vật Tư (UC-22)" {
  entity "VAT_TU" as VAT_TU {
    * **MaVatTu** : VARCHAR(20) <<PK>>
    --
    * TenVatTu : VARCHAR(100)
    * DonViTinh : VARCHAR(20)
    * SoLuongTon : INT
    * DonGiaNhap : DECIMAL(15,0)
  }

  entity "YEU_CAU_SUA_CHUA" as YEU_CAU_SUA_CHUA {
    * **MaYeuCau** : SERIAL <<PK>>
    --
    * MaPhong : VARCHAR(20) <<FK>>
    * MaSinhVien : VARCHAR(20) <<FK>>
    * TieuDe : VARCHAR(255)
    * MoTaChiTiet : TEXT
    HinhAnhDinhKem : VARCHAR(255)
    * MucDoUuTien : VARCHAR(20)
    * TrangThai : VARCHAR(20)
    * NgayTao : TIMESTAMP
    NgayHoanThanh : TIMESTAMP
    NguoiXuLy : VARCHAR(50)
    GhiChuKyThuat : TEXT
  }

  entity "XUAT_VAT_TU" as XUAT_VAT_TU {
    * **MaXuat** : SERIAL <<PK>>
    --
    * MaVatTu : VARCHAR(20) <<FK>>
    * MaYeuCau : INT <<FK>>
    * SoLuong : INT
    * NgayXuat : TIMESTAMP
    * NguoiXuat : VARCHAR(50)
    GhiChu : TEXT
  }
}

package "7. Phân Hệ An Ninh, Kỷ Luật & Audit (UC-14, UC-25)" {
  entity "RA_VAO" as RA_VAO {
    * **MaRaVao** : SERIAL <<PK>>
    --
    * MaSinhVien : VARCHAR(20) <<FK>>
    * LoaiSuKien : VARCHAR(10)
    * ThoiGian : TIMESTAMP
    * BaoVeGhiNhan : VARCHAR(50)
    GhiChu : VARCHAR(255)
  }

  entity "VI_PHAM" as VI_PHAM {
    * **MaViPham** : SERIAL <<PK>>
    --
    * MaSinhVien : VARCHAR(20) <<FK>>
    MaRaVao : INT <<FK>>
    * NoiDungViPham : TEXT
    * MucDo : VARCHAR(20)
    HinhThucXuLy : VARCHAR(255)
    * NgayGhiNhan : TIMESTAMP
    * TrangThai : VARCHAR(20)
  }

  entity "AUDIT_LOG" as AUDIT_LOG {
    * **LogId** : BIGSERIAL <<PK>>
    --
    * TableName : VARCHAR(50)
    * Action : VARCHAR(10)
    RecordId : VARCHAR(50)
    OldData : JSONB
    NewData : JSONB
    ChangedBy : VARCHAR(50)
    * ChangedAt : TIMESTAMP
  }
}

' Relationships
TAI_KHOAN ||--o| SINH_VIEN
HOC_KY ||--o{ DOT_DANG_KY
HOC_KY ||--o{ HOAT_DONG
HOC_KY ||--o{ QUY_DOI_DIEM

TOA_NHA ||--o{ PHONG
LOAI_PHONG ||--o{ PHONG
PHONG ||--o{ GIUONG
PHONG ||--o{ SINH_VIEN

SINH_VIEN ||--o{ DANG_KY_PHONG
GIUONG ||--o{ DANG_KY_PHONG
DANG_KY_PHONG ||--o| LUU_TRU
SINH_VIEN ||--o{ LUU_TRU
GIUONG ||--o{ LUU_TRU

SINH_VIEN ||--o{ SINH_VIEN_CHINH_SACH
CHINH_SACH_GIAM_GIA ||--o{ SINH_VIEN_CHINH_SACH

PHONG ||--o{ CHI_SO_DIEN_NUOC
PHONG ||--o{ HOA_DON
HOA_DON ||--o{ CHI_TIET_HOA_DON
HOA_DON ||--o{ THANH_TOAN

HOAT_DONG ||--o{ DANG_KY_CONG_ICH
SINH_VIEN ||--o{ DANG_KY_CONG_ICH
SINH_VIEN ||--o{ SO_DIEM_CONG_ICH
SINH_VIEN ||--o{ QUY_DOI_DIEM

PHONG ||--o{ YEU_CAU_SUA_CHUA
SINH_VIEN ||--o{ YEU_CAU_SUA_CHUA
YEU_CAU_SUA_CHUA ||--o{ XUAT_VAT_TU
VAT_TU ||--o{ XUAT_VAT_TU

SINH_VIEN ||--o{ RA_VAO
SINH_VIEN ||--o{ VI_PHAM
RA_VAO ||--o| VI_PHAM
@enduml
